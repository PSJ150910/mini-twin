 {
  "id": "mt5page",
  "type": "template",
  "z": "mt5tab",
  "name": "Floor plan page",
  "field": "payload",
  "fieldType": "msg",
  "format": "html",
  "syntax": "plain",
  "template": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Mini Twin floor plan</title>\n<!--\n  Mini Twin - floor-plan screen (Task 5)\n\n  A drawing of the 6-room office. Every 3 seconds this page asks Node-RED\n  for the combined room records (http://localhost:1880/twin, built in Task 4)\n  and colours each room by its temperature:\n      blue  = cool  (below 20 °C)\n      green = comfortable (20 to 25 °C)\n      red   = hot   (above 25 °C)\n  Click a room to see its live readings, its air machine and its repair\n  history side by side.\n\n  Node-RED serves this page at  http://localhost:1880/floorplan\n  You can also double-click this file to open it; it then asks\n  localhost:1880 directly for the data.\n-->\n<style>\n  :root {\n    --bg: #f4f6f8; --card: #ffffff; --ink: #1d2733; --muted: #5d6b7a; --line: #d5dce3;\n    --cool: #3b82f6; --cool-bg: #dbeafe;\n    --ok: #16a34a;   --ok-bg: #dcfce7;\n    --hot: #dc2626;  --hot-bg: #fee2e2;\n    --none: #94a3b8; --none-bg: #eef1f4;\n    --warn: #b45309; --warn-bg: #fef3c7;\n    --wall: #334155; --floor: #fbfcfd;\n  }\n  * { box-sizing: border-box; }\n  body { margin: 0; background: var(--bg); color: var(--ink);\n         font: 15px/1.45 \"Segoe UI\", system-ui, -apple-system, sans-serif; }\n  header { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px;\n           padding: 14px 20px; background: var(--card); border-bottom: 1px solid var(--line); }\n  header h1 { margin: 0; font-size: 19px; }\n  header .sub { color: var(--muted); font-size: 13px; }\n  .sources { display: flex; gap: 8px; flex-wrap: wrap; margin-left: auto; }\n  .pill { font-size: 12px; padding: 3px 10px; border-radius: 999px; background: var(--none-bg); color: var(--muted); }\n  .pill.ok { background: var(--ok-bg); color: #166534; }\n  .pill.bad { background: var(--hot-bg); color: #991b1b; }\n  .pill.wait { background: var(--warn-bg); color: #92400e; }\n\n  main { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(320px, 1fr); gap: 16px; padding: 16px 20px; align-items: start; }\n  @media (max-width: 900px) { main { grid-template-columns: 1fr; padding: 12px 16px; } }\n  .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; }\n\n  .legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: 13px; color: var(--muted); margin-top: 10px; }\n  .legend span::before { content: \"\"; display: inline-block; width: 12px; height: 12px; border-radius: 3px;\n                         margin-right: 6px; vertical-align: -1px; background: var(--c); }\n\n  svg { width: 100%; height: auto; display: block; }\n  .room { cursor: pointer; }\n  .room rect.fill { stroke: var(--wall); stroke-width: 3; transition: fill .6s; }\n  .room:hover rect.fill { stroke-width: 5; }\n  .room.selected rect.fill { stroke: #0f172a; stroke-width: 6; }\n  .room text { pointer-events: none; fill: var(--ink); }\n  .room .name { font-size: 17px; font-weight: 600; }\n  .room .temp { font-size: 30px; font-weight: 700; }\n  .room .small { font-size: 13px; fill: var(--muted); }\n  .room .badge { font-size: 13px; font-weight: 600; }\n  .room.alarm rect.ring { stroke: var(--hot); stroke-width: 4; fill: none; animation: pulse 1.4s infinite; }\n  .room.warning rect.ring { stroke: var(--warn); stroke-width: 3; fill: none; stroke-dasharray: 8 6; }\n  .room rect.ring { fill: none; stroke: none; }\n  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .15; } }\n\n  .panel h2 { margin: 0 0 2px; font-size: 20px; }\n  .panel h3 { margin: 18px 0 8px; font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }\n  .names { font-size: 12px; color: var(--muted); }\n  .alertbox { margin-top: 12px; padding: 10px 12px; border-radius: 8px; background: var(--none-bg); }\n  .alertbox.ok { background: var(--ok-bg); }\n  .alertbox.warning { background: var(--warn-bg); }\n  .alertbox.alarm { background: var(--hot-bg); }\n  .alertbox strong { display: block; margin-bottom: 2px; }\n  .alertbox ul { margin: 6px 0 0; padding-left: 18px; font-size: 13px; }\n  .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }\n  .tile { border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; }\n  .tile .k { font-size: 12px; color: var(--muted); }\n  .tile .v { font-size: 20px; font-weight: 700; }\n  .tile .v small { font-size: 12px; font-weight: 400; color: var(--muted); }\n  .status { font-weight: 700; }\n  .status.Running { color: var(--ok); } .status.Fault { color: var(--hot); } .status.Off { color: var(--muted); }\n  .ticket { border-left: 4px solid var(--line); padding: 6px 10px; margin-bottom: 8px; background: #fafbfc; border-radius: 0 6px 6px 0; }\n  .ticket.open { border-left-color: var(--hot); }\n  .ticket .t { font-weight: 600; }\n  .ticket .m { font-size: 12px; color: var(--muted); }\n  .ticket .r { font-size: 13px; margin-top: 3px; }\n  .empty { color: var(--muted); font-size: 14px; }\n  .hint { color: var(--muted); }\n  .error { background: var(--hot-bg); color: #991b1b; padding: 10px 12px; border-radius: 8px; margin: 12px 20px 0; display: none; }\n</style>\n</head>\n<body>\n<header>\n  <div>\n    <h1>Mini Twin: Ground floor</h1>\n    <div class=\"sub\" id=\"updated\">Connecting to Node-RED…</div>\n  </div>\n  <div class=\"sources\" id=\"sources\"></div>\n</header>\n<div class=\"error\" id=\"error\"></div>\n\n<main>\n  <section class=\"card\">\n    <svg id=\"plan\" viewBox=\"0 0 900 520\" role=\"img\" aria-label=\"Floor plan of the six rooms\">\n      <!-- outer walls and corridor -->\n      <rect x=\"10\" y=\"10\" width=\"880\" height=\"500\" fill=\"var(--floor)\" stroke=\"var(--wall)\" stroke-width=\"6\" rx=\"4\"/>\n      <text x=\"450\" y=\"283\" text-anchor=\"middle\" font-size=\"13\" fill=\"var(--muted)\" letter-spacing=\"4\">CORRIDOR</text>\n      <g id=\"rooms\"></g>\n      <!-- the front door, into Reception (drawn last so it sits on top) -->\n      <line x1=\"10\" y1=\"200\" x2=\"10\" y2=\"240\" stroke=\"var(--bg)\" stroke-width=\"10\"/>\n      <text x=\"22\" y=\"236\" font-size=\"12\" fill=\"var(--muted)\" pointer-events=\"none\">⇥ Entrance</text>\n    </svg>\n    <div class=\"legend\">\n      <span style=\"--c: var(--cool)\">Cool, below 20 °C</span>\n      <span style=\"--c: var(--ok)\">Comfortable, 20 to 25 °C</span>\n      <span style=\"--c: var(--hot)\">Hot, above 25 °C</span>\n      <span style=\"--c: var(--none)\">No data yet</span>\n    </div>\n    <p class=\"hint\" style=\"font-size:13px;margin:8px 0 0\">Click a room to see everything about it. A flashing red outline means an alarm, a dashed orange one a warning.</p>\n  </section>\n\n  <section class=\"card panel\" id=\"panel\">\n    <p class=\"hint\">Click a room on the plan.</p>\n  </section>\n</main>\n\n<script>\n// ---------------- Settings you can change ----------------\nconst COOL_BELOW = 20;   // °C: below this the room is drawn blue\nconst HOT_ABOVE  = 25;   // °C: above this the room is drawn red (same as the Task 4 alert rule)\nconst REFRESH_SECONDS = 3;\n// ----------------------------------------------------------\n\n// Where to get the data: the same Node-RED that served this page,\n// or localhost:1880 if this file was opened by double-clicking it.\nconst DATA_URL = location.protocol === \"file:\" ? \"http://localhost:1880/twin\" : \"/twin\";\n\n// Where each room sits on the drawing (x, y, width, height), keyed by the\n// one official room ID from Task 4.\nconst LAYOUT = {\n  room1: { x: 10,  y: 10,  w: 220, h: 240 },  // Reception, by the entrance\n  room2: { x: 230, y: 10,  w: 420, h: 240 },  // Open Office\n  room5: { x: 650, y: 10,  w: 240, h: 240 },  // Manager Office\n  room3: { x: 10,  y: 310, w: 330, h: 200 },  // Meeting Room\n  room4: { x: 340, y: 310, w: 300, h: 200 },  // Kitchen\n  room6: { x: 640, y: 310, w: 250, h: 200 }   // Quiet Room\n};\n\nlet rooms = {};          // latest combined record per room\nlet selected = null;     // which room the panel is showing\n\nfunction band(temp) {\n  if (temp === null || temp === undefined) return { key: \"none\", label: \"No data\" };\n  if (temp < COOL_BELOW) return { key: \"cool\", label: \"Cool\" };\n  if (temp > HOT_ABOVE)  return { key: \"hot\",  label: \"Hot\" };\n  return { key: \"ok\", label: \"Comfortable\" };\n}\n\n// Makes text safe to put on the page (so odd characters in a ticket can't break it)\nfunction esc(v) {\n  return String(v ?? \"\").replace(/[&<>\"']/g, c => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c]));\n}\nfunction num(v, digits) { return v === null || v === undefined || v === \"\" ? \"–\" : (digits === undefined ? v : Number(v).toFixed(digits)); }\nfunction when(iso) { return iso ? String(iso).replace(\"T\", \" \").slice(0, 16) : \"–\"; }\n\n// ---------- Draw the rooms once ----------\nconst NS = \"http://www.w3.org/2000/svg\";\nfunction el(tag, attrs, parent) {\n  const e = document.createElementNS(NS, tag);\n  for (const k in attrs) e.setAttribute(k, attrs[k]);\n  if (parent) parent.appendChild(e);\n  return e;\n}\nfunction drawRooms() {\n  const g = document.getElementById(\"rooms\");\n  for (const id in LAYOUT) {\n    const L = LAYOUT[id];\n    const grp = el(\"g\", { class: \"room\", id: \"g-\" + id, tabindex: 0, role: \"button\" }, g);\n    el(\"rect\", { class: \"fill\", x: L.x, y: L.y, width: L.w, height: L.h, fill: \"var(--none-bg)\" }, grp);\n    el(\"rect\", { class: \"ring\", x: L.x + 8, y: L.y + 8, width: L.w - 16, height: L.h - 16, rx: 6 }, grp);\n    const cx = L.x + L.w / 2, cy = L.y + L.h / 2;\n    el(\"text\", { class: \"name\", x: cx, y: cy - 38, \"text-anchor\": \"middle\" }, grp).textContent = id;\n    el(\"text\", { class: \"temp\", x: cx, y: cy + 4, \"text-anchor\": \"middle\" }, grp).textContent = \"–\";\n    el(\"text\", { class: \"small\", x: cx, y: cy + 28, \"text-anchor\": \"middle\" }, grp).textContent = \"\";\n    el(\"text\", { class: \"badge\", x: cx, y: cy + 52, \"text-anchor\": \"middle\" }, grp).textContent = \"\";\n    grp.addEventListener(\"click\", () => select(id));\n    grp.addEventListener(\"keydown\", e => { if (e.key === \"Enter\" || e.key === \" \") select(id); });\n  }\n}\n\n// ---------- Recolour the rooms with the latest data ----------\nfunction paintRooms() {\n  for (const id in LAYOUT) {\n    const r = rooms[id];\n    const grp = document.getElementById(\"g-\" + id);\n    const [name, temp, small, badge] = grp.querySelectorAll(\"text\");\n    const s = (r && r.summary) || {};\n    const b = band(s.temperature);\n    grp.querySelector(\"rect.fill\").setAttribute(\"fill\", \"var(--\" + b.key + \"-bg)\");\n    grp.querySelector(\"rect.fill\").setAttribute(\"stroke\", b.key === \"none\" ? \"var(--wall)\" : \"var(--\" + b.key + \")\");\n    grp.classList.toggle(\"alarm\", !!r && r.alert && r.alert.level === \"alarm\");\n    grp.classList.toggle(\"warning\", !!r && r.alert && r.alert.level === \"warning\");\n    grp.classList.toggle(\"selected\", selected === id);\n    name.textContent = r ? r.name : id;\n    temp.textContent = s.temperature != null ? num(s.temperature, 1) + \" °C\" : \"–\";\n    temp.setAttribute(\"fill\", b.key === \"none\" ? \"var(--muted)\" : \"var(--\" + b.key + \")\");\n    small.textContent = s.temperature != null\n      ? b.label + \" · \" + num(s.occupancy) + \" people · CO2 \" + num(s.co2) : \"Waiting for sensors\";\n    const bits = [];\n    if (s.ahu_status === \"Fault\") bits.push(\"⚠ Air machine fault\");\n    if (s.open_tickets) bits.push(\"🔧 \" + s.open_tickets + \" open job\" + (s.open_tickets > 1 ? \"s\" : \"\"));\n    badge.textContent = bits.join(\"   \");\n    badge.setAttribute(\"fill\", s.ahu_status === \"Fault\" ? \"var(--hot)\" : \"var(--warn)\");\n  }\n}\n\n// ---------- The side panel for one room ----------\nfunction select(id) { selected = id; paintRooms(); showPanel(); }\n\nfunction ticketHtml(t, open) {\n  return '<div class=\"ticket' + (open ? \" open\" : \"\") + '\">' +\n    '<div class=\"t\">#' + esc(t.ticket_id) + \" \" + esc(t.title) + \"</div>\" +\n    '<div class=\"m\">' + esc(t.type) + \" · \" + esc(t.priority) + \" · \" + esc(t.asset) + \" · \" +\n      (open ? \"opened \" + esc(when(t.opened)) + \" · \" + esc(t.assigned_to || \"not assigned\")\n            : esc(when(t.opened)) + \" to \" + esc(when(t.closed))) + \"</div>\" +\n    (t.resolution ? '<div class=\"r\">' + esc(t.resolution) + \"</div>\" : \"\") +\n    \"</div>\";\n}\n\nfunction showPanel() {\n  const p = document.getElementById(\"panel\");\n  const r = rooms[selected];\n  if (!r) { p.innerHTML = '<p class=\"hint\">Click a room on the plan.</p>'; return; }\n  const s = r.summary || {}, a = r.ahu || {}, sen = r.sensors || {}, al = r.alert || {};\n  const b = band(s.temperature);\n  const levelWord = { ok: \"All normal\", warning: \"Warning\", alarm: \"ALARM\", unknown: \"Waiting for data\" }[al.level] || \"\";\n  const reasons = (al.reasons || []).length\n    ? \"<ul>\" + al.reasons.map(x => \"<li>\" + esc(x) + \"</li>\").join(\"\") + \"</ul>\" : \"\";\n  const open = (r.tickets && r.tickets.open) || [];\n  const hist = (r.tickets && r.tickets.history) || [];\n  const ahuAsset = (r.assets || []).find(x => x.serves_room_air);\n\n  p.innerHTML =\n    \"<h2>\" + esc(r.name) + \"</h2>\" +\n    '<div class=\"names\">Also known as: ' + esc(r.ids.sensor) + \" (sensors) · \" + esc(r.ids.bms) + \" (BMS) · \" +\n      esc(r.ids.cafm_location) + \" / \" + esc(r.ids.cafm_name) + \" (CAFM)</div>\" +\n    '<div class=\"alertbox ' + esc(al.level) + '\"><strong>' + esc(levelWord) + \"</strong>\" + esc(al.message) + reasons + \"</div>\" +\n\n    \"<h3>Live readings (room sensors)</h3>\" +\n    '<div class=\"tiles\">' +\n      '<div class=\"tile\"><div class=\"k\">Temperature</div><div class=\"v\" style=\"color:var(--' + b.key + ')\">' + num(s.temperature, 1) + \" <small>°C</small></div></div>\" +\n      '<div class=\"tile\"><div class=\"k\">CO2 (stale air)</div><div class=\"v\">' + num(s.co2) + \" <small>ppm</small></div></div>\" +\n      '<div class=\"tile\"><div class=\"k\">People in room</div><div class=\"v\">' + num(s.occupancy) + \"</div></div>\" +\n    \"</div>\" +\n    '<div class=\"m names\" style=\"margin-top:6px\">Sensor time: ' + esc(when(sen.temperature && sen.temperature.time)) +\n      (s.data_fresh ? \"\" : \" · <b>no fresh data</b>\") + \"</div>\" +\n\n    \"<h3>Air machine (BMS) \" + esc(a.id) + \"</h3>\" +\n    '<div class=\"tiles\">' +\n      '<div class=\"tile\"><div class=\"k\">Status</div><div class=\"v status ' + esc(a.status) + '\">' + esc(a.status || \"–\") + \"</div></div>\" +\n      '<div class=\"tile\"><div class=\"k\">Air it blows in</div><div class=\"v\">' + num(a.supply_temp, 1) + \" <small>°C</small></div></div>\" +\n      '<div class=\"tile\"><div class=\"k\">Aiming for</div><div class=\"v\">' + num(a.setpoint, 1) + \" <small>°C</small></div></div>\" +\n      '<div class=\"tile\"><div class=\"k\">Fan speed</div><div class=\"v\">' + num(a.fan_speed, 0) + \" <small>%</small></div></div>\" +\n      '<div class=\"tile\" style=\"grid-column: span 2\"><div class=\"k\">Alarm message</div><div class=\"v\" style=\"font-size:15px\">' + esc(a.alarm || \"None\") + \"</div></div>\" +\n    \"</div>\" +\n    (ahuAsset ? '<div class=\"names\" style=\"margin-top:6px\">In the CAFM this machine is ' + esc(ahuAsset.asset_id) + \" (\" + esc(ahuAsset.model) +\n      \"), condition \" + esc(ahuAsset.condition) + \", last service \" + esc(ahuAsset.last_service) + \", next due \" + esc(ahuAsset.next_service) + \"</div>\" : \"\") +\n\n    \"<h3>Repair jobs (CAFM): \" + open.length + \" open</h3>\" +\n    (open.length ? open.map(t => ticketHtml(t, true)).join(\"\") : '<p class=\"empty\">No open jobs.</p>') +\n    \"<h3>Repair history</h3>\" +\n    (hist.length ? hist.map(t => ticketHtml(t, false)).join(\"\") : '<p class=\"empty\">No past jobs for this room.</p>');\n}\n\n// ---------- Ask Node-RED for fresh data every few seconds ----------\nasync function refresh() {\n  const err = document.getElementById(\"error\");\n  try {\n    const res = await fetch(DATA_URL, { cache: \"no-store\" });\n    if (!res.ok) throw new Error(\"Node-RED answered \" + res.status);\n    const data = await res.json();\n    rooms = {};\n    for (const r of data.rooms || []) rooms[r.id] = r;\n    err.style.display = \"none\";\n\n    const src = data.sources || {};\n    const names = { sensors: \"Sensors\", bms: \"Air machines (BMS)\", cafm: \"Repair log (CAFM)\" };\n    document.getElementById(\"sources\").innerHTML = Object.keys(names).map(k => {\n      const v = src[k] || \"waiting\";\n      const cls = v === \"ok\" ? \"ok\" : v === \"waiting\" ? \"wait\" : \"bad\";\n      return '<span class=\"pill ' + cls + '\">' + names[k] + \": \" + esc(v) + \"</span>\";\n    }).join(\"\");\n    document.getElementById(\"updated\").textContent = \"Live · updated \" + new Date().toLocaleTimeString();\n\n    paintRooms();\n    if (selected) showPanel();\n  } catch (e) {\n    err.style.display = \"block\";\n    err.textContent = \"Can't reach Node-RED at \" + DATA_URL + \". Is Node-RED running with the Task 4 flow deployed? (\" + e.message + \")\";\n  }\n}\n\ndrawRooms();\npaintRooms();\nrefresh();\nsetInterval(refresh, REFRESH_SECONDS * 1000);\n</script>\n</body>\n</html>\n",
  "output": "str",
  "x": 360,
  "y": 100,
  "wires": [
   [
    "mt5res"
   ]
  ]
 },
 {
  "id": "mt5res",
  "type": "http response",
  "z": "mt5tab",
  "name": "Send page",
  "statusCode": "",
  "headers": {
   "content-type": "text/html; charset=utf-8"
  },
  "x": 560,
  "y": 100,
  "wires": []
 }
